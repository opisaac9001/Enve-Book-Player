    {
      "name": "progression-put-invalid-payload",
      "priority": 10,
      "request": {
        "method": "PUT",
        "urlPathPattern": "/opds/progression/(lab-ebook-001|lab-ebook-101|lab-audiobook-001)"
      },
      "response": {
        "status": 400,
        "headers": {
          "Content-Type": "application/problem+json;charset=utf-8",
          "Cache-Control": "no-store"
        },
        "jsonBody": {
          "type": "https://registry.opds.io/error#progression-invalid-payload",
          "title": "The request is not a Progression Document",
          "status": 400,
          "detail": "A PUT must carry Content-Type application/opds-progression+json and a body with modified, a URI-shaped device.id, a non-empty device.name and a progression between 0 and 1."
        }
      }
