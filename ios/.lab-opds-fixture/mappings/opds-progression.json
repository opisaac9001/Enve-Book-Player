    {
      "name": "progression-lab-ebook-001-put-created",
      "priority": 3,
      "scenarioName": "opds-progression-lab-ebook-001",
      "requiredScenarioState": "Started",
      "newScenarioState": "Recorded",
      "request": {
        "method": "PUT",
        "urlPath": "/opds/progression/lab-ebook-001",
        "headers": {
          "Content-Type": {
            "contains": "application/opds-progression+json"
          }
        },
        "bodyPatterns": [
          {
            "matchesJsonPath": {
              "expression": "$.modified",
              "matches": "^\\d{4}-\\d{2}-\\d{2}[Tt]\\d{2}:\\d{2}:\\d{2}(\\.\\d+)?([Zz]|[+-]\\d{2}:?\\d{2})$"
            }
          },
          {
            "matchesJsonPath": {
              "expression": "$.device.id",
              "matches": "^[A-Za-z][A-Za-z0-9+.-]*:\\S+$"
            }
          },
          {
            "matchesJsonPath": {
              "expression": "$.device.name",
              "matches": "^\\s*\\S[\\s\\S]*$"
            }
          },
          {
            "matchesJsonPath": {
              "expression": "$.progression",
              "matches": "^(0|1|0\\.\\d+|1\\.0+|\\d+(\\.\\d+)?[eE]-\\d+)$"
            }
          }
        ]
      },
      "response": {
        "status": 201,
        "headers": {
          "Content-Type": "application/opds-progression+json;charset=utf-8",
          "Cache-Control": "no-store"
        },
        "body": "{{{request.body}}}",
        "transformers": ["response-template"]
      }
    },
