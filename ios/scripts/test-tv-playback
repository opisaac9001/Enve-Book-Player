#!/usr/bin/env python3
"""Run the production AVQueuePlayer on a booted Apple-silicon tvOS simulator."""
import argparse
import json
import plistlib
from pathlib import Path
import subprocess
import tempfile
import time
import wave

parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument("device", help="Booted tvOS simulator UDID")
args = parser.parse_args()
root = Path(__file__).resolve().parent.parent
bundle_id = "com.enve.tests.TVReadAlongPlayback"


def run(*command):
    return subprocess.check_output(command, text=True).strip()


with tempfile.TemporaryDirectory(prefix="enve-tv-playback-") as temporary:
    directory = Path(temporary)
    app = directory / "PlaybackTests.app"
    app.mkdir()
    source = (root / "enve-tvOS/TVStorytellerAudioPlayer.swift").read_text()
    # Compile the actual player without the download/ZIP loader in the same source file.
    marker = "nonisolated struct TVStorytellerBook: Sendable {"
    assert source.count(marker) == 1
    (directory / "Player.swift").write_text(source.split(marker)[0].replace("import Zip\n", ""))
    for name in ("one.wav", "two.wav"):
        with wave.open(str(app / name), "wb") as audio:
            audio.setnchannels(1)
            audio.setsampwidth(2)
            audio.setframerate(44100)
            audio.writeframes(b"\0\0" * 44100 * 5)
    (app / "Info.plist").write_bytes(plistlib.dumps({
        "CFBundleExecutable": "PlaybackTests",
        "CFBundleIdentifier": bundle_id,
        "CFBundleName": "PlaybackTests",
        "CFBundlePackageType": "APPL",
        "CFBundleVersion": "1",
        "CFBundleShortVersionString": "1.0",
        "CFBundleSupportedPlatforms": ["AppleTVSimulator"],
        "MinimumOSVersion": "17.0",
        "UIDeviceFamily": [3],
        "LSRequiresIPhoneOS": True,
        "UIApplicationSceneManifest": {"UIApplicationSupportsMultipleScenes": False},
    }))
    sdk = run("xcrun", "--sdk", "appletvsimulator", "--show-sdk-path")
    run("xcrun", "--sdk", "appletvsimulator", "swiftc", "-swift-version", "6", "-parse-as-library",
        "-sdk", sdk, "-target", "arm64-apple-tvos17.0-simulator", "-module-name", "PlaybackTests",
        str(directory / "Player.swift"),
        str(root / "enve-tvOS/TVStorytellerSMIL.swift"),
        str(root / "enve-tvOS/TVReadAlongProgressStore.swift"),
        str(root / "scripts/tests/TVReadAlongPlaybackTests.swift"),
        "-o", str(app / "PlaybackTests"))
    run("codesign", "--force", "--sign", "-", str(app))
    run("xcrun", "simctl", "install", args.device, str(app))
    try:
        container = Path(run("xcrun", "simctl", "get_app_container", args.device, bundle_id, "data"))
        result_path = container / "Documents/results.json"
        result_path.unlink(missing_ok=True)
        run("xcrun", "simctl", "launch", args.device, bundle_id)
        deadline = time.monotonic() + 90
        while time.monotonic() < deadline:
            if result_path.exists():
                result = json.loads(result_path.read_text())
                if result["complete"]:
                    break
            time.sleep(1)
        else:
            raise SystemExit("Playback tests timed out before completion")
        failed = [check for check in result["checks"] if not check["passed"]]
        for check in failed:
            print(json.dumps(check, sort_keys=True))
        print(f"TV playback: {len(result['checks']) - len(failed)} passed, {len(failed)} failed.")
        if failed:
            raise SystemExit(1)
    finally:
        run("xcrun", "simctl", "uninstall", args.device, bundle_id)
