<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Enve" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
    <style name="Theme.Enve.Splash" parent="Theme.Enve">
        <item name="android:windowBackground">@android:color/black</item>
    </style>

    <style name="Theme.Enve.Car" parent="Theme.Enve">
        <item name="android:colorAccent">@color/enve_ember</item>
        <item name="colorAccent">@color/enve_ember</item>
    </style>

    <style name="Theme.EnveCast" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:colorBackground">@android:color/black</item>
        <item name="colorPrimary">@android:color/black</item>
        <item name="colorPrimaryDark">@android:color/black</item>
        <item name="colorAccent">@android:color/white</item>
        <item name="android:colorControlNormal">@android:color/white</item>
    </style>

    <style name="Theme.EnveCastDialog" parent="Theme.AppCompat.Dialog">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:colorBackground">@android:color/black</item>
        <item name="android:windowIsTranslucent">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowAnimationStyle">@android:style/Animation.Dialog</item>
    </style>
</resources>
